# growth-agent configuration. All credentials are env-only; keys are never
# committed and never stored in the business database.
#
# Copy this file to `.env` (gitignored) for local config. `serve.ts` loads
# `.env` at startup; tests and direct config imports do NOT load it.

# HTTP
GA_HOST=127.0.0.1
GA_PORT=8790
# When set, all /api/v1 routes require `Authorization: Bearer <token>`.
GA_API_TOKEN=

# Storage: sqlite (local, default) | postgres (production)
GA_DB_DRIVER=sqlite
# sqlite file path (local dev); use :memory: for ephemeral runs
GA_SQLITE_PATH=./data/growth-agent.db
# postgres (production); requires the optional `pg` dependency:
# GA_DB_DRIVER=postgres
# DATABASE_URL=postgres://user:pass@localhost:5432/growth_agent

# zeus decision kernel integration (T-A3).
# off (default): deterministic offline client, zero network, runs the script.
GA_ZEUS_MODE=off
# online: submit decisions to the zeus Decision API and receive lifecycle
# webhooks. Selecting online without url/token fails closed (never offline).
# GA_ZEUS_MODE=online
# GA_ZEUS_URL=http://127.0.0.1:3020
# GA_ZEUS_TOKEN=
# Public URL zeus POSTs decision lifecycle events to; re-registered on boot
# (zeus subscriptions are in-memory and lost on restart).
# GA_ZEUS_CALLBACK_URL=http://127.0.0.1:8790/webhooks/zeus
# Shared secret used to verify inbound zeus webhooks (x-zeus-signature); >=16.
# GA_ZEUS_MODE=online without this secret fails closed at startup (T-A5).
# GA_ZEUS_WEBHOOK_SECRET=
# v2 replay-defense freshness window for x-zeus-webhook-* headers (default 300).
# GA_ZEUS_WEBHOOK_MAX_SKEW_SECONDS=300

# Connector BYOK credentials (design §8). They live ONLY in this gitignored
# file / your secrets store — never in the business database, logs, errors
# or the browser bundle. Logs mask every token to its first 4 chars (§8).

# --- GSC read-only connector (T-B1/B2/B3; strictly READ-ONLY scope) ---
# off (default): deterministic offline fixture, zero network, zero Google API.
GA_GSC_MODE=off
# online: run the installed-app OAuth once (local loopback 127.0.0.1 callback)
# to obtain a refresh token. Selecting online below without all four values
# fails closed (422 GSC_CREDENTIAL_MISSING) — it never silently falls back.
# GA_GSC_MODE=online
# GA_GSC_CLIENT_ID=
# GA_GSC_CLIENT_SECRET=
# AES-256 master key for the sealed refresh-token file (design §8 names this
# GROWTH_MASTER_KEY; env-prefixed here as GA_GROWTH_MASTER_KEY). Must decode
# to 32 bytes: 64 hex chars or base64 of 32 bytes.
# GA_GROWTH_MASTER_KEY=
# Directory holding the ENCRYPTED refresh-token file (§8 "gsc_tokens" volume;
# ciphertext and this key are deliberately separated — the key stays in env).
# GA_GSC_TOKEN_DIR=./data/gsc-tokens

# --- Ads read-only connector (OP-30/OP-32; weekly spend + ROI) ---
# off (default): deterministic offline fixture, zero network.
GA_ADS_MODE=off
# online: reserved for the real ad-platform read-only transport (OP-31), which
# is blocked on the ad-account authorization. Selecting online today fails
# closed (422 ADS_CREDENTIAL_MISSING) — it never silently falls back.
# GA_ADS_MODE=online

# --- SERP BYOK connector (T-C1; your own DataForSEO-class account, billed to you) ---
GA_SERP_MODE=off
# GA_SERP_MODE=online
# GA_SERP_DATAFORSEO_LOGIN=
# GA_SERP_DATAFORSEO_PASSWORD=

# --- Loom content pipeline adapter (T-E4; openapi-reconciled) ---
# off (default): deterministic in-memory mock, zero network.
GA_LOOM_MODE=off
# online: speak the real loom FastAPI wire contract
#   POST /api/content/generate   body {final_id, kind, language, actor{id,roles['operations']}}
#   GET  /api/content/{content_id}?tenant_id=...
# Selecting online without url/tenant fails closed (422), never the mock.
# GA_LOOM_MODE=online
# GA_LOOM_URL=http://127.0.0.1:8000     # self-hosted loom base URL, no trailing slash
# GA_LOOM_TENANT_ID=                    # required by the GET wire contract
# GA_LOOM_TOKEN=                        # optional Bearer; only when loom staff_auth gate is on
# GA_LOOM_LANGUAGE=en                   # wire language sent on generate
# NOTE: loom issues final_id out-of-band via /api/fcw/assemble (needs
# product_space_id + platform + slot_id); growth-agent passes a pre-issued
# finalId and never calls the human approve/reject/revise console.

# --- GitHub publisher (T-D2/D3): opens branches + PRs, never merges ---
# off (default): deterministic in-memory fake publisher, zero network.
GA_GITHUB_MODE=off
# online: REST API over global fetch (no octokit). The target repository
# (owner/repo/baseBranch) comes from the selected site config in
# config/sites/*.json; there is intentionally no global owner/repo default,
# so one deployment can publish to several repositories (F-05).
# Selecting online without the token fails closed (422 CREDENTIAL_MISSING),
# never silently fake.
# GA_GITHUB_MODE=online
# GA_GITHUB_TOKEN=          # repo-scope PAT (or fine-grained contents + pull-requests write)
# Shared secret configured in the GitHub webhook; used to verify
# X-Hub-Signature-256 on inbound pull_request events; >=16 chars.
# GA_GITHUB_MODE=online without this secret fails closed at startup (T-D3).
# GA_GITHUB_WEBHOOK_SECRET=

# --- Draft source for the production batch (§5.C) ---
# inbox (default): the operator drops one JSON file per approved task at
#   <GA_DRAFT_INBOX_DIR>/<taskId>.json
#     { "slug": "guides/example",
#       "title": "...",
#       "changeSummary": "...",
#       "paragraphs": ["...", "...", "..."],   # >= 3; structural check only
#       "finalId": "fcw_..." }                 # loom mode only
# Zero network, zero credentials — this is what makes a first real dogfood run
# possible before any BYOK key exists. A missing or malformed file leaves the
# task in `drafting` for the next tick; it never fabricates content, and a
# structural problem never burns the one qa_revision rework.
# loom: the file carries only the envelope plus an operator-issued final_id and
#   loom writes the article. Requires GA_LOOM_MODE=online; selecting loom
#   without it fails closed at startup so a mock article can never reach a PR.
GA_DRAFT_MODE=inbox
GA_DRAFT_INBOX_DIR=./data/drafts

# --- Cost ledger (T-A7, design §11) and weekly report (T-A8) ---
# JSON map of provider -> micros per unit; empty/zero rates cost nothing.
# Malformed JSON fails closed at startup. Offline mode needs no rates.
# GA_COST_RATES='{"serp:dataforseo":1200,"gsc":0,"llm":1500}'
# Directory for versioned weekly reports (never overwritten; no email).
GA_REPORT_DIR=./data/reports

# --- docker-compose stack (deploy/docker-compose.yml; copy to .env) ---
# Batch scheduler sidecar (deploy/batch-scheduler.sh). It runs `daily`,
# `production` and `verify` each tick; all three are idempotent, so a tick with
# nothing to do is a no-op. `report` / `packet` are NOT in the loop — invoke
# them on their own schedule, since they version their output.
# BATCH_SITE=bayjf.com
# BATCH_INTERVAL_SECONDS=3600
# BATCH_DAILY_HOUR_UTC=6
# Strong random secrets; .env is gitignored and never committed.
# POSTGRES_PASSWORD=
# ZEUS_INTERNAL_TOKEN=
# ZEUS_RSK_KEY_ID=local-rsk
# Optional: prebuilt growth-os image for the `peers` profile.
# GROWTH_OS_IMAGE=growth-os:local
# Set to postgres to use the postgres service (requires a pg-enabled image;
# see deploy/SELF_HOSTING.md). Defaults to sqlite.
# GA_DB_DRIVER=sqlite
