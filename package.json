{
  "name": "growth-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted, BYOK growth PR agent: every day produces one new-content PR and one page-fix PR behind a human approval gate. Orchestrator shell that wires zeus (decisions), growth-os (signals), loom (content) and ops-console (approval surface) over HTTP/openapi only.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node --experimental-sqlite dist/serve.js",
    "batch": "node --experimental-sqlite dist/cli/batch.js",
    "test": "vitest run",
    "lint": "eslint .",
    "migrate:up": "node --experimental-sqlite scripts/migrate.mjs up",
    "migrate:status": "node --experimental-sqlite scripts/migrate.mjs status",
    "migrate:pg:up": "node scripts/migrate.mjs up --driver postgres",
    "migrate:pg:status": "node scripts/migrate.mjs status --driver postgres",
    "check:migrations": "bash scripts/check-migrations.sh",
    "smoke:offline": "sh scripts/dogfood-smoke.sh",
    "check:all": "npm run check:migrations && npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "eslint": "^9.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.1.0"
  }
}
